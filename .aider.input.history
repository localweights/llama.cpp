+
+    // Eagle3 detection: pre_projection input cols = 3*n_bb (h_low||h_mid||h_high)
+    const int64_t pre_proj_cols = mtp.mtp_pre_projection->ne[0];
+    const bool is_eagle3 = (pre_proj_cols == 3 * n_bb);
+
