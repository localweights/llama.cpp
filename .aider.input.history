+            const int64_t n_exp_used = (int64_t) mtp.hparams.n_expert_used;
+            cur = build_moe_ffn(cur,
+                    mtp.layers[il].ffn_gate_inp,
+                    mtp.layers[il].ffn_up_exps,
+                    mtp.layers[il].ffn_gate_exps,
+                    mtp.layers[il].ffn_down_exps,
+                    nullptr,
+                    n_exp, n_exp_used,
+                    LLM_FFN_SILU, true,
+                    0.0f,
+                    LLAMA_EXPERT_GATING_FUNC_TYPE_SOFTMAX,
+                    il,
+                    nullptr, nullptr,
+                    nullptr, nullptr, nullptr);
+            cb(cur, "ffn_moe_out", il);
+        } else {
+            cur = build_ffn(cur,
+                    mtp.layers[il].ffn_up,   nullptr, nullptr,
+                    mtp.layers[il].ffn_gate, nullptr, nullptr,
+                    mtp.layers[il].ffn_down, nullptr, nullptr,
+                    nullptr,
+                    LLM_FFN_GELU, LLM_FFN_PAR, il);
+            cb(cur, "ffn_out", il);
+        }
+
+        cur = ggml_add(ctx0, cur, attn_out);
+```
+
+## Acceptance
+Build succeeds:
+```bash
+cd /mnt/scratch/llama-upstream-wt/build-cuda && cmake --build . --target llama-server -j 16 2>&1 | tail -5
+```
+Must end with something like: `[100%] Linking CXX executable llama-server` or `[100%] Built target llama-server` with no errors.
+
+## Out of scope
+Do NOT modify any other file. Do NOT change load_arch_hparams beyond adding the 3 KV reads. Do NOT change the attention section, RoPE, or post-projection code.

